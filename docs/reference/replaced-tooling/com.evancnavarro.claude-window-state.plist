<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.evancnavarro.claude-window-state</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOUR-USERNAME/.local/bin/claude-window-state</string>
		<string>--apply</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/claude-window-state.err</string>
	<key>StartInterval</key>
	<integer>5</integer>
</dict>
</plist>
